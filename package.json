{
  "name": "ad-vitals",
  "version": "0.1.0",
  "description": "Attribute Core Web Vitals damage to individual ad slots. Finds which ad is costing you CLS and INP, and how much.",
  "keywords": [
    "core-web-vitals",
    "cls",
    "layout-shift",
    "adsense",
    "google-ad-manager",
    "gpt",
    "prebid",
    "publisher",
    "seo",
    "performance",
    "inp",
    "ads"
  ],
  "license": "MIT",
  "author": "Mateus de Carvalho (MATAPOMBO)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MATAPOMBO/ad-vitals.git"
  },
  "bugs": {
    "url": "https://github.com/MATAPOMBO/ad-vitals/issues"
  },
  "homepage": "https://github.com/MATAPOMBO/ad-vitals#readme",
  "type": "module",
  "bin": {
    "ad-vitals": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
